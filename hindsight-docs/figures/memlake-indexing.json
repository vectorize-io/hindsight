  "scenes": [
    {
      "label": "Indexing",
      "beats": [
        {
          "edges": {
            "edge": "idx-log",
            "data": "wal/42–43"
          },
          "show": {
            "idx": [
              {
                "tag": "fold",
                "tone": "orange",
                "text": "2 new entries"
              }
            ]
          },
          "say": "In the background, an indexer reads the new log entries."
        },
        {
          "edges": {
            "edge": "idx-segs",
            "data": "seg-7 (new)"
          },
          "show": {
            "segs": [
              {
                "tag": "seg-5",
                "tone": "green",
                "text": "live"
              },
              {
                "tag": "seg-6",
                "tone": "green",
                "text": "live"
              },
              {
                "tag": "seg-7",
                "tone": "orange",
                "text": "built · not yet published"
              }
            ]
          },
          "say": "It builds a small immutable segment, linking memories as it goes. Cost follows what's new, not what's stored.",
          "ms": 3200
        },
        {
          "edges": {
            "edge": "idx-manifest",
            "data": "swap · if-match"
          },
          "show": {
            "manifest": [
              {
                "tag": "live",
                "tone": "purple",
                "text": "seg-5 · seg-6 · seg-7"
              }
            ],
            "segs": [
              {
                "tag": "seg-5",
                "tone": "green",
                "text": "live"
              },
              {
                "tag": "seg-6",
                "tone": "green",
                "text": "live"
              },
              {
                "tag": "seg-7",
                "tone": "green",
                "text": "live"
              }
            ]
          },
          "light": [
            "manifest"
          ],
          "say": "It publishes by swapping the manifest with a conditional write. Readers see the old version or the new one — never half."
        },
        {
          "say": "Two indexers on the same bank, with no lock between them?",
          "ms": 2400,
          "light": [
            "idx",
            "idx2"
          ]
        },
        {
          "edges": [
            {
              "edge": "idx-manifest",
              "data": "swap ✓"
            },
            {
              "edge": "idx2-manifest",
              "data": "swap ✗ stale"
            }
          ],
          "show": {
            "idx2": [
              {
                "tag": "lost",
                "tone": "red",
                "text": "files never referenced"
              }
            ]
          },
          "say": "Both build, exactly one wins the swap. The loser's files are simply never referenced — and garbage collection removes only what no manifest points to.",
          "ms": 3600
        }
      ]
    }
  ],
  "view": {
    "width": 1280,
    "height": 760
  }
