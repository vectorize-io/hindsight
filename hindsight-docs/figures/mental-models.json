                "text": "Bob: retrieval evals",
                "mark": "same"
              },
              {
                "tag": "research",
                "tone": "blue",
                "text": "Alice: joined in March",
                "mark": "added"
              },
              {
                "tag": "ml team",
                "tone": "purple",
                "text": "Carol: ranker fine-tuning",
