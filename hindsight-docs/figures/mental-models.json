          "ms": 3200
        },
        {
          "edges": {
            "edge": "refresh",
            "data": "refresh"
          },
          "show": {
            "reflect": [
              {
                "text": "read only what is new since v1"
              }
            ]
          },
          "say": "In delta mode the refresh reads only the memories that arrived since the last one."
        },
        {
          "edges": {
            "edge": "read-src",
