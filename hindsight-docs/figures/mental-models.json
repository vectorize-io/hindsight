          "show": {
            "mm": [
              {
                "tag": "research",
                "tone": "blue",
                "text": "Bob: retrieval evals"
              },
              {
                "tag": "ml team",
                "tone": "purple",
                "text": "Carol: ranker fine-tuning"
              },
              {
                "text": "based on 2 observations, 1 fact",
                "meta": "v1"
              }
            ]
          },
          "say": "The answer is stored as a document, together with the evidence it was built from.",
          "ms": 3000
        }
      ]
    },
    {
      "label": "stay current",
      "caption": "",
      "beats": [
        {
          "show": {
            "obs": [
              {
                "text": "Bob runs the retrieval evals",
                "meta": "4 sources"
              },
              {
                "text": "Carol moved to ML to fine-tune the ranker",
                "meta": "3 sources"
              },
              {
                "text": "Alice joined the research team",
                "meta": "2 sources",
                "mark": "new"
              }
            ],
            "mm": [
              {
                "tag": "research",
                "tone": "blue",
                "text": "Bob: retrieval evals"
              },
              {
                "tag": "ml team",
                "tone": "purple",
                "text": "Carol: ranker fine-tuning"
              },
              {
                "text": "based on 2 observations, 1 fact",
