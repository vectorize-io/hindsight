{
  "title": "Observation Consolidation",
  "speed": 2200,
  "elements": [
    {
      "id": "facts",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "Facts"
        },
        {
          "type": "subtitle",
          "text": "from retain"
        }
      ],
      "minCardHeight": 73,
      "width": 200
    },
    {
      "id": "find",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "Find related"
        },
        {
          "type": "subtitle",
          "text": "observations in the same tag scope"
        }
      ],
      "minCardHeight": 43,
      "width": 210
    },
    {
      "id": "llm",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "LLM decides"
        },
        {
          "type": "subtitle",
          "text": "create · update · delete"
        }
      ],
      "minCardHeight": 43,
      "width": 210
    },
    {
      "id": "dedup",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "Near-duplicate check"
        },
        {
          "type": "subtitle",
          "text": "merge or keep"
        }
      ],
      "minCardHeight": 43,
      "width": 210
    },
    {
      "id": "g1",
      "type": "group",
      "label": {
        "title": "Hindsight Worker · Consolidation"
      },
      "children": [
        "find",
        "llm",
        "dedup"
      ],
      "layout": {
        "direction": "column",
        "gap": 36,
        "align": "stretch"
      }
    },
    {
      "id": "obs",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "Observations"
        },
        {
          "type": "subtitle",
          "text": "one belief per facet"
        }
      ],
      "minCardHeight": 133,
      "width": 230
    },
    {
      "id": "history",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "Observation history"
        },
        {
          "type": "subtitle",
          "text": "previous versions"
        }
      ],
      "minCardHeight": 103,
      "width": 230
    },
    {
      "id": "g2",
      "type": "group",
      "label": {
        "title": "Memory Bank"
      },
      "children": [
        "obs",
        "history"
      ],
      "layout": {
        "direction": "column",
        "gap": 36,
        "align": "stretch"
      }
    },
    {
      "id": "g0",
      "type": "group",
      "children": [
        "facts",
        "g1",
        "g2"
      ],
      "layout": {
        "direction": "row",
        "gap": 40,
        "align": "center"
      }
    },
    {
      "id": "in",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "facts"
      },
      "end": {
        "id": "find"
      },
      "label": {
        "text": "new facts"
      }
    },
    {
      "id": "search",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "find"
      },
      "end": {
        "id": "obs"
      },
      "label": {
        "text": "recall"
      }
    },
    {
      "id": "find->llm",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "find"
      },
      "end": {
        "id": "llm"
      }
    },
    {
      "id": "llm->dedup",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "llm"
      },
      "end": {
        "id": "dedup"
      }
    },
    {
      "id": "write",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "dedup"
      },
      "end": {
        "id": "obs"
      },
      "label": {
        "text": "write"
      }
    },
    {
      "id": "snapshot",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "dedup"
      },
      "end": {
        "id": "history"
      },
      "label": {
        "text": "old text"
      }
    }
  ],
  "scenes": [
    {
      "label": "refine",
      "caption": "",
      "beats": [
        {
          "show": {
            "facts": [
              {
                "tag": "new fact",
                "tone": "green",
                "text": "User praises React’s component model",
