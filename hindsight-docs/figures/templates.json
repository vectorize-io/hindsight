        "refresh"
      ],
      "layout": {
        "direction": "column",
        "gap": 40,
        "align": "stretch"
      }
    },
    {
      "id": "d-config",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "Config"
        },
        {
          "type": "subtitle",
          "text": "per-bank overrides"
        }
      ],
      "minCardHeight": 73
    },
    {
      "id": "d-mm",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "Mental Models"
        }
