  "scenes": [
    {
      "label": "Architecture",
      "beats": [
        {
          "edges": {
            "edge": "hs-sA",
            "data": "retain · recall · reflect"
          },
          "say": "The Hindsight API talks to a Memlake server. Any server can answer any request, so there is no primary."
        },
        {
          "edges": {
            "edge": "sA-log",
            "data": "PUT · if-none-match"
          },
          "say": "Servers A and B each keep a RAM and an NVMe cache, and hold no durable state of their own."
        },
        {
          "edges": {
            "edge": "sA-manifest",
            "data": "head · if-match"
          },
          "say": "Everything durable lives in your bucket, per tenant and bank: a log with one object per write, immutable segment indexes, and a manifest whose head is the only object that changes."
        },
        {
          "edges": {
            "edge": "idx-segs",
            "data": "log → segments"
          },
          "say": "In the background an indexer folds the log into segments, and an archiver copies the log to a backup bucket in another account."
        }
      ]
    }
