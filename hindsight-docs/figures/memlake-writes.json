 "scenes": [
  {
   "label": "Writes",
   "beats": [
    {
     "edges": {
      "edge": "hs-sA",
      "data": "retain(doc)"
     },
     "show": {
      "hs": [
       {
        "tag": "retain",
        "tone": "blue",
        "text": "new facts + entities + replace old"
       }
      ]
     },
     "say": "Hindsight retains a document: replace its old facts, write the new ones, register new entities \u2014 one write."
    },
    {
     "edges": {
      "edge": "sA-log",
      "data": "PUT wal/43 \u00b7 if-none-match"
     },
     "show": {
      "log": [
       {
        "tag": "wal/41",
        "tone": "orange",
        "text": "indexed"
       },
       {
        "tag": "wal/42",
        "tone": "orange",
        "text": "committed"
       },
       {
        "tag": "wal/43",
        "tone": "green",
        "text": "claimed \u00b7 durable"
       }
      ]
     },
     "say": "The server claims the next log slot with a conditional create. Two writers can never take the same slot.",
     "ms": 3200
    },
    {
     "edges": {
      "edge": "sA-manifest",
      "data": "head \u2192 43 \u00b7 if-match"
     },
     "show": {
      "manifest": [
       {
        "tag": "head",
        "tone": "purple",
        "text": "43"
       }
      ]
     },
     "say": "Once the entry is durable, the head pointer moves forward \u2014 another conditional write."
    },
    {
     "edges": {
      "edge": "hs-sA",
      "back": true,
      "data": "\u2713 saved"
     },
     "light": [
      "log",
      "manifest"
     ],
     "say": "Only then is the write acknowledged. It's already searchable \u2014 no waiting for an indexer."
    }
   ]
  }
 ],
