 "scenes": [
  {
   "label": "Recall",
   "beats": [
    {
     "edges": {
      "edge": "hs-sA",
      "data": "recall(query)"
     },
     "show": {
      "hs": [
       {
        "tag": "recall",
        "tone": "blue",
        "text": "+ ranking policy: fusion \u00b7 rerank \u00b7 budget"
       }
      ]
     },
     "say": "Hindsight sends a recall, with its ranking policy attached."
    },
    {
     "edges": {
      "edge": "sA-manifest",
      "data": "latest head?"
     },
     "say": "The server checks for the latest writes \u2014 the one request a warm query always makes."
    },
    {
     "edges": [
      {
       "edge": "sA-segs",
       "data": "ranged reads"
      },
      {
       "edge": "sA-log",
       "data": "unindexed tail"
      }
     ],
     "show": {
      "sA": [
       {
        "tag": "cache",
        "tone": "green",
        "text": "segment blocks: hit"
       },
       {
        "tag": "tail",
        "tone": "orange",
        "text": "wal/43 scanned"
       }
      ]
     },
     "say": "It reads only the blocks it needs \u2014 mostly from its cache \u2014 and scans the part of the log not yet indexed.",
     "ms": 3200
    },
    {
     "show": {
      "sA": [
       {
        "tag": "vector",
        "tone": "blue",
        "text": "meaning"
       },
       {
        "tag": "keyword",
        "tone": "blue",
        "text": "BM25"
       },
       {
        "tag": "graph",
        "tone": "blue",
        "text": "entities \u00b7 links"
       },
       {
        "tag": "time",
        "tone": "blue",
        "text": "window"
       }
      ]
     },
     "light": [
      "sA"
     ],
     "say": "Four searches run over the same memories at once\u2026",
     "ms": 2800
    },
    {
     "show": {
      "sA": [
       {
        "tag": "ranked",
        "tone": "green",
        "text": "fused \u00b7 reranked \u00b7 within budget"
       }
      ]
     },
     "say": "\u2026then Hindsight's ranking policy is applied next to the data."
