  "scenes": [
    {
      "label": "Failover",
      "beats": [
        {
          "say": "A server disappears. It held a cache — never data.",
          "ms": 2400,
          "light": [
            "sA"
          ]
        },
        {
          "edges": {
            "edge": "hs-sB",
            "data": "recall(query)"
          },
          "say": "Its banks move to another server. No handover, no replica to promote."
        },
        {
          "edges": [
            {
              "edge": "sB-manifest",
              "data": "latest head?"
            },
            {
              "edge": "sB-segs",
              "data": "ranged reads"
            }
          ],
          "show": {
            "sB": [
              {
                "tag": "cache",
                "tone": "orange",
                "text": "warming from the bucket"
              }
            ]
          },
          "say": "It reads the same bucket, and its cache warms as it serves.",
          "ms": 3000
        },
        {
          "edges": {
            "edge": "hs-sB",
            "back": true,
            "data": "top memories"
          },
          "light": [
            "sB"
          ],
          "say": "Every acknowledged write is still there: it was never on the lost server."
        }
      ]
    }
  ],
